generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AvaliacaoLoja {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  loja_id             Int
  nota                Int
  comentario          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Loja                Loja                  @relation(fields: [loja_id], references: [id])
  Usuario             Usuario               @relation(fields: [usuario_id], references: [id])
  ComentarioAvaliacao ComentarioAvaliacao[]
}

model AvaliacaoProduto {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  produto_id          Int
  nota                Int
  comentario          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Produto             Produto               @relation(fields: [produto_id], references: [id])
  Usuario             Usuario               @relation(fields: [usuario_id], references: [id])
  ComentarioAvaliacao ComentarioAvaliacao[]
}

model Categoria {
  id               Int         @id @default(autoincrement())
  nome             String
  categoria_pai_id Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  CategoriaPai     Categoria?  @relation("CategoriaToCategoria", fields: [categoria_pai_id], references: [id])
  SubCategorias    Categoria[] @relation("CategoriaToCategoria")
  Produto          Produto[]
}

model ComentarioAvaliacao {
  id                   Int               @id @default(autoincrement())
  usuario_id           Int
  avaliacao_loja_id    Int?
  avaliacao_produto_id Int?
  conteudo             String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  AvaliacaoLoja        AvaliacaoLoja?    @relation(fields: [avaliacao_loja_id], references: [id])
  AvaliacaoProduto     AvaliacaoProduto? @relation(fields: [avaliacao_produto_id], references: [id])
  Usuario              Usuario           @relation(fields: [usuario_id], references: [id])
}

model ImagemProduto {
  id         Int      @id @default(autoincrement())
  produto_id Int
  url_imagem String
  ordem      Int
  createdAt  DateTime @default(now())
  Produto    Produto  @relation(fields: [produto_id], references: [id])
}

model Loja {
  id            Int             @id @default(autoincrement())
  usuario_id    Int
  nome          String
  endereco      String
  descricao     String?
  logo_url      String?
  banner_url    String?
  sticker_url   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Usuario       Usuario         @relation(fields: [usuario_id], references: [id])
  Produto       Produto[]
  AvaliacaoLoja AvaliacaoLoja[]
}

model Movimentacao {
  id         Int              @id @default(autoincrement())
  produto_id Int
  tipo       MovimentacaoTipo
  quantidade Int
  createdAt  DateTime         @default(now())
  Produto    Produto          @relation(fields: [produto_id], references: [id])
}

model Produto {
  id               Int                @id @default(autoincrement())
  loja_id          Int
  categoria_id     Int
  nome             String
  descricao        String?
  preco            Decimal            @db.Decimal(10, 2)
  estoque          Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  AvaliacaoProduto AvaliacaoProduto[]
  ImagemProduto    ImagemProduto[]
  Movimentacao     Movimentacao[]
  Categoria        Categoria          @relation(fields: [categoria_id], references: [id])
  Loja             Loja               @relation(fields: [loja_id], references: [id])
}

model Usuario {
  id                  Int                   @id @default(autoincrement())
  username            String
  email               String                @unique
  senha_hash          String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AvaliacaoLoja       AvaliacaoLoja[]
  AvaliacaoProduto    AvaliacaoProduto[]
  ComentarioAvaliacao ComentarioAvaliacao[]
  Loja                Loja[]
}

enum MovimentacaoTipo {
  entrada
  saida
}
